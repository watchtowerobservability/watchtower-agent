<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.watchtower.agent</string>
  <!-- Never root: install.sh creates the _wtagent account. Install this file as a LaunchDaemon. -->
  <key>UserName</key><string>_wtagent</string>
  <key>GroupName</key><string>_wtagent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/wt-agent</string>
    <string>-config</string>
    <string>/usr/local/etc/wt-agent/agent.yaml</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/usr/local/var/wt-agent/agent.log</string>
</dict>
</plist>
