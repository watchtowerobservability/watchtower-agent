{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["endpoint", "tokenSecret"],
  "properties": {
    "endpoint": { "type": "string", "minLength": 1 },
    "fleetEndpoint": { "type": "string" },
    "tokenSecret": { "type": "string", "minLength": 1 },
    "tokenKey": { "type": "string", "minLength": 1 },
    "fleetMode": { "enum": ["opamp", ""] },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
    "commands": { "type": "array" },
    "csi": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "socketRoot": { "type": "string", "pattern": "^/.+" } } },
    "openshift": { "type": "object", "properties": { "scc": { "type": "boolean" } } },
    "injection": { "type": "object", "properties": { "enabled": { "type": "boolean" } } }
  }
}
